{
  "name": "ivmova-static-reader",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:root": "next build",
    "build:pages": "set NEXT_PUBLIC_BASE_PATH=/ivmova.github.io&& next build",
    "typecheck": "node scripts/publication-build.mjs && tsc --noEmit",
    "start": "next start",
    "publication:import": "node scripts/publication-consumer.mjs import",
    "publication:rollback": "node scripts/publication-consumer.mjs rollback",
    "test:publication-consumer": "node scripts/test-publication-consumer.mjs",
    "test:publication-builds": "node scripts/test-publication-builds.mjs"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwindcss": "4.2.1"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
