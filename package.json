{
  "name": "ivmova-static-reader",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:root": "next build",
    "build:pages": "set NEXT_PUBLIC_BASE_PATH=/ivmova.github.io&& next build",
    "typecheck": "node scripts/publication-build.mjs && tsc --noEmit",
    "start": "next start",
    "publication:import": "node scripts/publication-consumer.mjs import",
    "publication:rollback": "node scripts/publication-consumer.mjs rollback",
    "test:publication-consumer": "node scripts/test-publication-consumer.mjs",
    "test:publication-builds": "node scripts/test-publication-builds.mjs",
    "publication:state": "node scripts/publication-consumer.mjs state",
    "publication:recovery-plan": "node scripts/publication-consumer.mjs recovery-plan",
    "publication:recover": "node scripts/publication-consumer.mjs recover",
    "publication:lock": "node scripts/publication-consumer.mjs lock",
    "test:publication-recovery": "node scripts/test-publication-recovery.mjs",
    "test:publication-release": "node scripts/test-publication-release.mjs",
    "test:publication-workflow": "node scripts/test-publication-workflow.mjs",
    "publication:build-only": "node scripts/publication-build-only-staging.mjs",
    "test:publication-ledger": "node scripts/test-publication-git-ledger.mjs",
    "test:pages-reconciliation": "node scripts/test-pages-reconciliation.mjs",
    "test:publication-artifact": "node scripts/test-publication-artifact.mjs",
    "publication:prepare": "node scripts/publication-git-ledger.mjs prepare"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwindcss": "4.2.1"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
