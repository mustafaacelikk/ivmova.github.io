{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"IVMOVA frozen export input v2",
  "type":"object","additionalProperties":false,
  "required":["schemaVersion","exportId","generatedAt","runType","target","itemCount","items"],
  "properties":{
    "schemaVersion":{"const":2},"exportId":{"type":"string","format":"uuid"},
    "generatedAt":{"type":"string","format":"date-time"},"runType":{"enum":["FULL","INCREMENTAL"]},
    "target":{"const":"GITHUB_PAGES"},"itemCount":{"type":"integer","minimum":0},
    "items":{"type":"array","maxItems":1000,"items":{
      "type":"object","additionalProperties":false,
      "required":["storyId","slug","action","artifactPath","revisionId","revisionNumber","revisionContentHash","story"],
      "properties":{
        "storyId":{"type":"string","format":"uuid"},
        "slug":{"type":"string","maxLength":200,"pattern":"^[a-z0-9]+(-[a-z0-9]+)*$"},
        "action":{"enum":["UPSERT","RETRACT","REMOVE"]},
        "artifactPath":{"type":"string","maxLength":500,"pattern":"^stories/(tr|en)/[a-z0-9]+(-[a-z0-9]+)*[.]json$"},
        "revisionId":{"type":["string","null"],"format":"uuid"},
        "revisionNumber":{"type":["integer","null"],"minimum":1},
        "revisionContentHash":{"type":["string","null"],"pattern":"^[0-9a-f]{64}$"},
        "story":{"anyOf":[{"$ref":"public-story-export.schema.json"},{"type":"null"}]}
      },
      "allOf":[{"if":{"required":["action"],"properties":{"action":{"const":"REMOVE"}}},
        "then":{"properties":{"revisionId":{"type":"null"},"revisionNumber":{"type":"null"},"revisionContentHash":{"type":"null"},"story":{"type":"null"}}},
        "else":{"properties":{"revisionId":{"type":"string"},"revisionNumber":{"type":"integer"},"revisionContentHash":{"type":"string"},"story":{"type":"object"}}}
      }]
    }}
  }
}
