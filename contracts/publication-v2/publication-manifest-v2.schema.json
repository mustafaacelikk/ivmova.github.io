{
  "$schema":"https://json-schema.org/draft/2020-12/schema","title":"IVMOVA publication manifest v2",
  "$comment":"Application MUST verify itemCount/actionCounts, sorted unique storyId/artifactPath, proof identity and canonical byte hash. No manifest self hash.",
  "type":"object","additionalProperties":false,
  "required":["schemaVersion","exportId","generatedAt","runType","target","itemCount","actionCounts","items"],
  "properties":{
    "schemaVersion":{"const":2},"exportId":{"type":"string","format":"uuid"},
    "generatedAt":{"type":"string","format":"date-time"},"runType":{"enum":["FULL","INCREMENTAL"]},
    "target":{"const":"GITHUB_PAGES"},"itemCount":{"type":"integer","minimum":0},
    "actionCounts":{"type":"object","additionalProperties":false,"required":["UPSERT","RETRACT","REMOVE"],"properties":{
      "UPSERT":{"type":"integer","minimum":0},"RETRACT":{"type":"integer","minimum":0},"REMOVE":{"type":"integer","minimum":0}
    }},
    "items":{"type":"array","maxItems":1000,"uniqueItems":true,"items":{
      "type":"object","additionalProperties":false,
      "required":["storyId","slug","action","artifactPath","revisionId","revisionNumber","revisionContentHash","artifactSha256","artifactBytes","removalProof","removalReceiptSha256"],
      "properties":{
        "storyId":{"type":"string","format":"uuid"},"slug":{"type":"string","maxLength":200,"pattern":"^[a-z0-9]+(-[a-z0-9]+)*$"},
        "action":{"enum":["UPSERT","RETRACT","REMOVE"]},
        "artifactPath":{"type":"string","maxLength":500,"pattern":"^stories/(tr|en)/[a-z0-9]+(-[a-z0-9]+)*[.]json$"},
        "revisionId":{"type":["string","null"],"format":"uuid"},"revisionNumber":{"type":["integer","null"],"minimum":1},
        "revisionContentHash":{"type":["string","null"],"pattern":"^[0-9a-f]{64}$"},
        "artifactSha256":{"type":["string","null"],"pattern":"^[0-9a-f]{64}$"},"artifactBytes":{"type":["integer","null"],"minimum":0},
        "removalProof":{"anyOf":[{"$ref":"publication-removal-proof-v2.schema.json"},{"type":"null"}]},
        "removalReceiptSha256":{"type":["string","null"],"pattern":"^[0-9a-f]{64}$"}
      },
      "allOf":[{"if":{"required":["action"],"properties":{"action":{"const":"REMOVE"}}},
        "then":{"properties":{"revisionId":{"type":"null"},"revisionNumber":{"type":"null"},"revisionContentHash":{"type":"null"},"artifactSha256":{"type":"null"},"artifactBytes":{"type":"null"},"removalProof":{"type":"object"},"removalReceiptSha256":{"type":"string"}}},
        "else":{"properties":{"revisionId":{"type":"string"},"revisionNumber":{"type":"integer"},"revisionContentHash":{"type":"string"},"artifactSha256":{"type":"string"},"artifactBytes":{"type":"integer"},"removalProof":{"type":"null"},"removalReceiptSha256":{"type":"null"}}}
      }]
    }}
  }
}
