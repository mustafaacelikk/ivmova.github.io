{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseId",
    "releaseRecordSha256",
    "deployTreeSha256",
    "status",
    "evidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "releaseId": {
      "type": "string",
      "format": "uuid"
    },
    "releaseRecordSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "deployTreeSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "DEPLOYED",
        "RECONCILED",
        "FAILED"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "workflowRunId",
        "workflowRunAttempt",
        "pagesDeploymentId",
        "markerSha256",
        "observedAt",
        "outcome"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "workflowRunId": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "workflowRunAttempt": {
          "type": "integer",
          "minimum": 1
        },
        "pagesDeploymentId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "markerSha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "outcome": {
          "enum": [
            "DEPLOYED",
            "RECONCILED",
            "NOT_DEPLOYED",
            "UNKNOWN"
          ]
        }
      }
    }
  }
}
