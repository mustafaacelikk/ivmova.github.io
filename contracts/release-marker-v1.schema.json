{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "release-marker-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "releaseId",
    "treeHash",
    "sourceCommit",
    "generatedAt",
    "contractVersion"
  ],
  "properties": {
    "releaseId": {
      "type": "string",
      "format": "uuid"
    },
    "treeHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "contractVersion": {
      "const": 2
    }
  }
}
